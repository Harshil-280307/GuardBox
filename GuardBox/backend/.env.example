# ==============================================================================
# Veronic GuardBox - Backend Environment Configuration (.env) - Phase 3
# ==============================================================================
# IMPORTANT:
# 1. Never commit real private keys or sensitive credentials.
# 2. If your camera password contains special characters like @, :, /, #, %, etc.,
#    they MUST be URL-encoded (e.g. "@" becomes "%40", ":" becomes "%3A").
# 3. For TP-Link Tapo C100, create a camera account in the Tapo App:
#    Camera Settings -> Advanced Settings -> Camera Account
# ==============================================================================

# RTSP Stream URL (Required)
# Format: rtsp://<username>:<password>@<CAMERA_IP>:554/stream1
RTSP_URL=rtsp://office:office123@192.168.31.108:554/stream1

# Motion Detection & False Alarm Reduction Parameters
# MOTION_SENSITIVITY: 1 (low sensitivity) to 100 (high sensitivity). Default: 25
MOTION_SENSITIVITY=25

# MIN_MOTION_AREA: Minimum contour area in pixels to trigger an event. Default: 500
MIN_MOTION_AREA=500

# MOTION_COOLDOWN_SECONDS: Minimum seconds between consecutive motion events. Default: 5
MOTION_COOLDOWN_SECONDS=5

# MOTION_PERSISTENCE_SECONDS: Motion must continuously persist for this duration before triggering. Default: 1.0
MOTION_PERSISTENCE_SECONDS=1.0

# CAMERA_WARMUP_SECONDS: Skip motion detection during camera warm-up after connection. Default: 3.0
CAMERA_WARMUP_SECONDS=3.0

# BLUR_SIZE: Gaussian kernel size for noise reduction (odd integer). Default: 9
BLUR_SIZE=9

# FRAME_SCALE: Downscale factor for OpenCV motion processing (0.2 to 1.0). Default: 0.5
FRAME_SCALE=0.5

# Arming & Exit Delay Configuration
# ENTRY_DELAY_SECONDS: Simulated entry grace window in seconds. Default: 15
ENTRY_DELAY_SECONDS=15

# EXIT_DELAY_SECONDS: Exit countdown before system transitions to ARMED. Default: 15
EXIT_DELAY_SECONDS=15

# Storage & Database Paths
SNAPSHOT_DIRECTORY=snapshots
DATABASE_PATH=guardbox.db
SNAPSHOT_RETENTION_DAYS=30

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Phase 3: Android Emergency Alert & Firebase Cloud Messaging (FCM) Configuration
# Obtain from Firebase Console -> Project Settings -> Cloud Messaging / Service Accounts
FCM_SERVER_KEY=
FCM_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Push Alert Escalation Parameters
AUTO_PUSH_ENABLED=true
PUSH_TIMEOUT_SECONDS=30
MAX_RETRY_CYCLES=2
MIN_ALERT_SEVERITY=HIGH
ALERT_COOLDOWN_SECONDS=60

# Phase 5.4: Supabase Storage Configuration (Snapshot Evidence)
# Supabase project URL and service role secret key
SUPABASE_URL=https://idgtlvqzjnjbsorgtyao.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=trinetra-snapshots

